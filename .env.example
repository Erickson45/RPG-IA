# Copie este arquivo para .env.
# Sem chave, o Zetsu funciona no modo roteirizado (de graça e offline).

# Para ligar a IA de verdade, coloque tua chave da Anthropic:
# ANTHROPIC_API_KEY=sk-ant-...

# Modelo usado pelo Zetsu (padrão: claude-opus-5-5).
# Para gastar menos, dá para trocar por claude-haiku-5-5.
# ZETSU_MODELO=claude-opus-5-5

# Quantas vezes por hora cada jogador (IP) pode pedir a segunda opinião da IA (cada pedido custa).
# LIMITE_IA_POR_HORA=20

# Quantos heróis novos por hora o mesmo endereço (IP) pode criar. Folgado por causa de escolas e empresas,
# onde a turma inteira sai pela internet com o mesmo IP.
# LIMITE_CRIAR_POR_HORA=150
